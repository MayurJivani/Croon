# Required. Local: docker compose up -d db
DATABASE_URL=postgres://croon:croon@localhost:5442/croon
# Required, 32+ characters: openssl rand -hex 32
CSRF_SECRET=
# Optional. development | production (default production: secure cookies, no stack traces)
NODE_ENV=development
# Optional, default 4398
PORT=4398
# Optional. Without it, karaoke videos are attached by pasting a YouTube link; with it, the song
# page can search YouTube (Data API v3, 100 quota units per search, results cached in memory).
YOUTUBE_API_KEY=
# Optional. English lyric translations, made once per song and cached. Either key works:
# Google Cloud Translation (500k characters a month free) or DeepL (a free key ends in :fx).
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
# Optional. Reverse proxies in front (cloudflared + Caddy = 2), so rate limits see real visitors.
TRUST_PROXY=0
# Optional. 1 (default) pre-fetches synced lyrics for playable songs at startup so lyric search works.
WARM_LYRICS=1
